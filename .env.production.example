# Amazon Review Insight production environment
#
# Copy this file to .env on the server and fill in real values:
#   cp .env.production.example .env

# Public host port for the frontend container.
# Use 80 when this app owns the server's HTTP port.
# Use 8081 when you put Nginx/Caddy/Cloudflare Tunnel in front.
APP_PORT=80

# Worker concurrency. Increase only if the server has enough CPU/memory and LLM quota.
RQ_WORKER_CONCURRENCY=2

# Admin-only analytics dashboard token for /admin.
# Generate a strong token, for example:
#   openssl rand -hex 32
ANALYTICS_ADMIN_TOKEN=replace-with-a-long-random-admin-token

# LLM provider keys. At least one provider must be configured.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
QWEN_API_KEY=
MINIMAX_API_KEY=

# Optional provider endpoint overrides.
DEEPSEEK_BASE_URL=https://api.deepseek.com
GEMINI_BASE_URL=
QWEN_BASE_URL=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# Optional model overrides.
DEEPSEEK_MODEL=deepseek-v4-flash
GEMINI_MODEL=
QWEN_MODEL=
MINIMAX_MODEL=MiniMax-M3
