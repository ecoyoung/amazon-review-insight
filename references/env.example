# Amazon Review Insight environment template
#
# Export these variables before running scripts/check_env.py or
# scripts/run_multi_agent_workflow.py. Provider base URLs and models are read
# from config/provider_registry.json and can be overridden by *_BASE_URL and
# *_MODEL variables.

# Example provider keys used by provider_registry/runtime_config:
# DEEPSEEK_API_KEY=your-deepseek-key
# GEMINI_API_KEY=your-gemini-key
# QWEN_API_KEY=your-qwen-key
# MINIMAX_API_KEY=your-minimax-key

# Optional overrides:
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
